{
  "name": "shadows-of-almia-showdown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shadows of Almia Showdown: a Pokémon battle royale demo with PMD SpriteCollab sprites and Pokémon Ranger overworld NPCs on painted terrain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-sprites": "python3 scripts/fetch-sprites.py --list scripts/species-list.txt"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
