{
  "name": "nightfall-royale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nightfall Royale: a Pokémon battle royale demo with PMD SpriteCollab sprites on painted terrain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-sprites": "python3 scripts/fetch-sprites.py --list scripts/species-list.txt",
    "fetch-rangers": "python3 scripts/fetch-rangers.py"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
